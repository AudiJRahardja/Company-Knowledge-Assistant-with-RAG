# Copy this file to .env and fill in your values. Never commit .env.

# Which LLM writes the answers: gemini or ollama
LLM_PROVIDER=gemini

# Gemini (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is overloaded (HTTP 503), too slow, or retired (404).
# List what your key can use with: python -m rag.llm --models
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
# Seconds to wait for one answer before giving up on that attempt
GEMINI_TIMEOUT_S=30

# Ollama (local models, optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embedding model used for search. auto = GPU if available, otherwise CPU
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto

# Search steps (Phase 3). Each can be switched off to measure what it adds.
RETRIEVAL_HYBRID=1          # keyword (BM25) search next to vector search
RETRIEVAL_MERGE_TWINS=1     # show one language copy of each section, not both
RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # set to none to turn reranking off
QUERY_REWRITE=1             # rewrite follow-up questions before searching (one extra LLM call)
RETRIEVAL_SPLIT_QUESTIONS=1 # also search each part of a two-part question separately
RETRIEVAL_HIDE_SUPERSEDED=1 # leave out outdated policy versions unless the question asks about old rules

# Security (Phase 4)
MAX_QUESTION_CHARS=1000
RATE_LIMIT_EXTERNAL=10      # questions per minute per visitor
RATE_LIMIT_INTERNAL=30      # questions per minute per signed-in employee
# Secret used to sign login tokens. Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty, a random one is used and everyone is signed out when the API restarts.
JWT_SECRET=
JWT_TTL_MINUTES=480
